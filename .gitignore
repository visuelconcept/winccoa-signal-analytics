# =============================================================================
# WebUI Runtime Workspace .gitignore
#
# This repo versions the Signal Analytics module ONLY. The runtime workspace is
# scaffolded IN PLACE by `webui-runtime-init` and stays untracked — see
# DEVELOPMENT.md. This file must be self-contained.
#
# The module now lives where the runtime discovers pages by itself, INSIDE a
# scaffolded directory:
#
#   libs/default-components/src/lib/standalone-pages/signal-analytics.ts   tracked
#   libs/default-components/src/lib/standalone-pages/signal-analytics/     tracked
#   everything else under libs/default-components/                         untracked
#
# Git tracks files, not directories, so that split needs no ignore rule: the
# scaffold files are simply never added. `git status` therefore lists the whole
# scaffold as untracked (`??`) — that is the intended steady state, not drift.
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/

# -----------------------------------------------------------------------------
# Build output
# -----------------------------------------------------------------------------
dist/
dev-dist/
out-tsc/
*.tgz
*.tgz.bak
*.tar.gz
.license-cache.json
.deploy-release-cache.json

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# -----------------------------------------------------------------------------
# Vite / Vitest
# -----------------------------------------------------------------------------
vite.config.*.timestamp*
vitest.config.*.timestamp*

# -----------------------------------------------------------------------------
# TypeScript
# -----------------------------------------------------------------------------
**/.tsbuildinfo
/tsconfig.base.tsbuildinfo

# -----------------------------------------------------------------------------
# Nx
# -----------------------------------------------------------------------------
**/.nx/cache
**/.nx/workspace-data
**/.nx/artifacts

